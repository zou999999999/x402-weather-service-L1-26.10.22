# ==========================================
# x402 付费天气 API 服务环境变量配置模板
# ==========================================

# 1. 基础服务端口（本地开发）
PORT=3000

# 2. 服务端收款钱包公开地址（PayTo 地址）
PAY_TO=0xdcD7DAFafb0EF3d50bDdB480Dbd503Fa6D1B6C09

# 3. Agent 付款钱包配置（仅运行客户端 scripts/client.js 时需要）
PAYER_ADDRESS=0x4830D4857AdA8b000aFC1C2702294B0999dEaFB3
PAYER_PRIVATE_KEY=0x你的测试网私钥

# 4. 天气数据源切换 (openmeteo | amap，默认 openmeteo 免注册免 Key)
PROVIDER=openmeteo

# 5. 高德天气 Web 服务 Key (仅当 PROVIDER=amap 时需要)
# AMAP_KEY=你的高德Web服务Key
