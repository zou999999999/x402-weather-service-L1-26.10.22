# ==========================================
# 客户端 (Client / Agent Consumer) 环境变量配置模板
# ⚠️ 此文件仅用于 Agent 本地钱包与签名，严禁提交到远程仓库！
# ==========================================

# 1. 目标服务请求地址（本地为 http://localhost:3000，云端为 Vercel 域名）
TARGET_URL=http://localhost:3000

# 2. 付款方 Agent 钱包公开地址与私钥
PAYER_ADDRESS=0x4830D4857AdA8b000aFC1C2702294B0999dEaFB3
PAYER_PRIVATE_KEY=0x你的测试网私钥

# 3. 预期的服务端收款钱包 (用于核验 402 账单 payTo 是否合规)
PAY_TO=0xdcD7DAFafb0EF3d50bDdB480Dbd503Fa6D1B6C09

# 4. 人工确认控制开关 (设为 yes 时将直接签名并向链上扣费)
# CONFIRM=yes
