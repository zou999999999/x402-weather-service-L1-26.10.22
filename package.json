{
  "name": "x402-weather-service-monorepo",
  "version": "1.0.0",
  "description": "x402 Paid Weather API Service - Standardized Monorepo Architecture",
  "main": "server/server.js",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "server:start": "node server/server.js",
    "client:run": "node client/src/client.js",
    "client:reconcile": "node client/src/reconcile.js",
    "client": "node client/src/client.js",
    "reconcile": "node client/src/reconcile.js"
  },
  "dependencies": {
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "@x402/fetch": "^2.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "viem": "^2.23.0"
  }
}
