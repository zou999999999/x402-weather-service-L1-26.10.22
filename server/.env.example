# ==========================================
# 服务端 (Server / Provider) 环境变量配置模板
# ⚠️ 服务端绝对不含任何付款私钥！
# ==========================================

# 1. 服务运行端口
PORT=3000

# 2. 服务端收款钱包公开地址 (PayTo 地址)
PAY_TO=0xdcD7DAFafb0EF3d50bDdB480Dbd503Fa6D1B6C09

# 3. 天气数据源类型 (openmeteo | amap，默认 openmeteo 免注册免 Key)
PROVIDER=openmeteo

# 4. 高德天气 Web 服务 Key (仅当 PROVIDER=amap 时需要)
# AMAP_KEY=你的高德Web服务Key
